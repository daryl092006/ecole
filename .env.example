NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-anon

# Serveur uniquement : ne jamais utiliser un préfixe NEXT_PUBLIC_ pour cette clé.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-serveur-service-role

# Origine exacte du site : CORS, écritures publiques et lien de retour (aussi au build).
ESCEN_WEBSITE_URL=http://localhost:3200

# Adaptation de la copie du site : node scripts/connect-website.mjs.
# Le mode local est conservé par défaut. En production, les deux origines HTTPS
# doivent être renseignées explicitement avant de régénérer le site.
ESCEN_WEBSITE_MODE=local
ESCEN_PORTAL_URL=http://127.0.0.1:3000
ESCEN_PUBLIC_SITE_URL=http://localhost:3200

# Facultatif, uniquement derrière un proxy qui écrase cet en-tête.
# ESCEN_TRUSTED_IP_HEADER=x-forwarded-for

# Envoi serveur Microsoft Graph (RBAC Exchange limité à la boîte expéditrice).
# Activer seulement après configuration ; ne jamais préfixer ces secrets par NEXT_PUBLIC_.
ESCEN_EMAIL_PROVIDER=microsoft
ESCEN_EMAIL_ENABLED=false
ESCEN_EMAIL_FROM=noreply@escen.university
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Secret indépendant d'au moins 32 caractères pour POST /api/email-outbox/process.
ESCEN_EMAIL_WORKER_SECRET=
# Alternative : ESCEN_EMAIL_PROVIDER=resend et RESEND_API_KEY.

# Fonction Supabase auth-email : secret de signature distinct du secret Microsoft.
ESCEN_AUTH_EMAIL_ENABLED=false
ESCEN_AUTH_EMAIL_HOOK_SECRET=

# Activer après node scripts/prepare-first-login.mjs --apply pour préserver les comptes déjà utilisés.
ESCEN_FIRST_LOGIN_ENABLED=false
