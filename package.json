{
  "name": "escen-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint",
    "test": "node scripts/verify-workflows.cjs && npm run test:db",
    "test:db": "node scripts/verify-database.mjs && node scripts/verify-teacher-profile-recovery.mjs",
    "test:legacy": "python3 scripts/prepare-legacy-data.py --self-test",
    "db:describe": "node scripts/describe-database.mjs",
    "db:stage": "node scripts/load-legacy-stage.mjs",
    "test:ui": "playwright test",
    "db:stage:remote": "node scripts/push-legacy-stage.mjs",
    "db:verify:remote": "node scripts/verify-remote-database.mjs",
    "storage:upload:legacy": "node scripts/upload-legacy-archives.mjs",
    "storage:verify:legacy": "node scripts/verify-remote-storage.mjs",
    "db:prepare-identities": "node scripts/prepare-legacy-identities.mjs",
    "db:import-identities": "node scripts/import-legacy-identities.mjs",
    "db:verify-identities-local": "node scripts/import-legacy-identities.mjs --verify-local",
    "auth:restore-legacy": "node scripts/restore-legacy-auth-users.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^1.31.0",
    "next": "^15.5.27",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.27",
    "typescript": "^5"
  }
}
